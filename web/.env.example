# Web app configuration (backend). Copy to web/backend/.env for local dev.
# Point at any Azure AI Search index; auth is Managed Identity (az login locally).
SEARCH_ENDPOINT=https://YOURSEARCH.search.windows.net
SEARCH_INDEX_NAME=content-index
# Optional overrides (defaults match the crawler's index):
# SEARCH_SEMANTIC_CONFIG=semcfg
# SEARCH_VECTOR_FIELD=vector

# Needed only for snapshot thumbnails (the /api/thumbnail proxy):
STORAGE_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net
SNAPSHOTS_CONTAINER=snapshots

# Conversational RAG assistant (GPT-5.1-chat synthesis + GPT-5-mini planner):
FOUNDRY_ENDPOINT=https://YOURFOUNDRY.cognitiveservices.azure.com/
CHAT_DEPLOYMENT=gpt-5.5
PLANNER_DEPLOYMENT=gpt-5.4-mini
OPENAI_API_VERSION=2025-04-01-preview

# User-assigned MI client id (set automatically in Container Apps; leave blank locally):
# AZURE_CLIENT_ID=
