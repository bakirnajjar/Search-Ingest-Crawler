# ------------------------------------------------------------------------------
# Target site (REQUIRED) — nothing is hardcoded to a specific domain.
# ------------------------------------------------------------------------------
# Comma-separated robots.txt or sitemap URLs to seed the crawl from.
CRAWL_SITEMAP_URLS=https://www.example.com/robots.txt
# Optional: comma-separated allowed domains. If empty, derived from the sitemap hostnames.
CRAWL_ALLOWED_DOMAINS=
# Optional: comma-separated hosts whose images/docs may be downloaded. If empty, uses allowed domains.
CRAWL_ASSET_HOSTS=

# Example (multi-domain):
# CRAWL_SITEMAP_URLS=https://www.example.com/robots.txt,https://docs.example.com/sitemap.xml
# CRAWL_ALLOWED_DOMAINS=example.com,www.example.com,docs.example.com

# ------------------------------------------------------------------------------
# Azure Blob Storage
# ------------------------------------------------------------------------------
# Managed Identity (preferred). ACA injects credentials for the assigned UAMI.
STORAGE_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net

# Local fallback ONLY (do not use in production / do not commit real values):
# STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Container names (defaults shown)
BLOB_CONTAINER_PAGES=pages
BLOB_CONTAINER_IMAGES=images
BLOB_CONTAINER_DOCS=docs
BLOB_CONTAINER_SNAPSHOTS=snapshots

# Feature flags
CAPTURE_SNAPSHOTS=true
SNAPSHOT_PDF=true
# Skip snapshot + asset re-download for pages whose content is unchanged since last crawl
INCREMENTAL=true
# Harvest images from the JS-rendered DOM (captures lazy-loaded images)
HARVEST_RENDERED_IMAGES=true

# Politeness tuning
CRAWLER_CONCURRENCY=8
CRAWLER_CONCURRENCY_PER_DOMAIN=4
CRAWLER_DOWNLOAD_DELAY=0.5
LOG_LEVEL=INFO

# ==============================================================================
# Deployment — Azure Container Apps Job (infra/deploy.ps1)
# All of these can be passed on the CLI instead; CLI args override .env.
# ==============================================================================
RESOURCE_GROUP=rg-search-ingest-crawler
LOCATION=uaenorth
# Storage account NAME (the crawler runtime uses STORAGE_ACCOUNT_URL above).
STORAGE_ACCOUNT=YOURACCOUNT
# Azure Container Registry name (globally unique, alphanumeric).
ACR_NAME=searchingestcrawleracr
ACA_ENVIRONMENT=search-ingest-crawler-env
ACA_IDENTITY=id-search-ingest-crawler
ACA_JOB_NAME=search-ingest-crawler-job
# Blank = timestamp tag generated at deploy time.
IMAGE_TAG=
CRON=0 2 * * *
REPLICA_TIMEOUT=43200
REPLICA_RETRY=1
SNAPSHOT_RETENTION_DAYS=30

# ==============================================================================
# Azure AI Search indexer — Stage 2 (indexer/deploy.ps1, indexer/query-sample.ps1)
# Reuses RESOURCE_GROUP + STORAGE_ACCOUNT above.
# ==============================================================================
SEARCH_SERVICE=YOURSEARCHSERVICE
FOUNDRY_ACCOUNT=YOURFOUNDRY
EMBED_DEPLOYMENT=text-embedding-3-large
EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=3072
INDEX_NAME=content-index
SKILLSET_NAME=content-skillset
SEARCH_API_VERSION=2024-11-01-Preview
